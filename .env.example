# Copy this file to .env and fill in your own values. Never commit .env.

# Name shown in the UI and used by the assistant to describe itself
ASSISTANT_NAME=AIDX Assistant

# LLM provider: "anthropic" (real API) or "mock" (offline, free, for testing)
LLM_PROVIDER=anthropic
LLM_API_KEY=your-api-key-here
# Model ID from https://docs.claude.com/en/docs/about-claude/models
LLM_MODEL=your-model-id-here
LLM_MAX_TOKENS=800

# Retrieval
RAG_TOP_K=4
CHROMA_DIR=chroma_data

# Anonymous session memory
SESSION_MAX_TURNS=10
SESSION_TTL_MINUTES=60

MAX_MESSAGE_CHARS=2000

# Database (default: aidx.db in the project folder)
# DATABASE_URL=sqlite:///aidx.db

# Signs login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
LOGIN_DAYS=7
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# Personal memory
MEMORY_MAX_ITEMS_IN_PROMPT=8
MEMORY_RULE_MAX_CHARS=300
