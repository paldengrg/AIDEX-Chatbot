# Copy this file to .env and fill in your own values. Never commit .env.

# Name shown in the UI and used by the assistant to describe itself
ASSISTANT_NAME=AIDEX Assistant

# LLM provider: "ollama" (a local model, e.g. Gemma) or "mock" (no model, for testing)
LLM_PROVIDER=ollama
# Any model you have pulled in Ollama (see `ollama list`)
LLM_MODEL=gemma2:2b
# Optional: a smaller, faster model for memory extraction (defaults to LLM_MODEL)
LLM_FAST_MODEL=
LLM_MAX_TOKENS=800
# Where Ollama is listening
OLLAMA_URL=http://localhost:11434

# Retrieval
RAG_TOP_K=8
CHROMA_DIR=chroma_data

# Anonymous session memory
SESSION_MAX_TURNS=10
SESSION_TTL_MINUTES=60

MAX_MESSAGE_CHARS=2000

# Database (default: aidx.db in the project folder)
# DATABASE_URL=sqlite:///aidx.db

# Signs login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
LOGIN_DAYS=7
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# Personal memory
MEMORY_MAX_ITEMS_IN_PROMPT=8
MEMORY_RULE_MAX_CHARS=300
# Learn memories automatically from chat (true/false)
AUTO_LEARN=true

# Guardrails: maximum requests per person
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_15MIN=10

# Research study. Keep false until ethics approval is confirmed: all research
# logs are then marked as synthetic demo data.
ETHICS_APPROVED=false

# Admin dashboard at /admin. Leave ADMIN_PASSWORD empty to disable it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
